/* ============================================================
 * AXIS 内核链接脚本
 * ============================================================
 * 定义内核的内存布局
 *
 * 内核加载地址：1MB（0x100000）
 * 这是传统的内核加载位置，避开低内存区域
 */

/* 输出格式：x86-64 架构 ELF */
OUTPUT_FORMAT(elf64-x86-64)

/* 入口点：_boot 符号（定义于 arch/x86_64/boot.asm）
 * 
 * Bootloader（BIOS Stage2 / UEFI）在进入长模式后跳转到此符号。
 * _boot 负责建立恒等映射页表、清零 BSS、设置引导栈，
 * 然后调用 Rust 入口 _boot_rust。
 */
ENTRY(_boot)

/* 内核虚拟地址基址：当前为 0，即内核链接在低地址（物理 = 虚拟）。
 * 高半核（0xFFFFFFFF80000000）是远景目标；届时只需修改本常量，
 * 并由 boot.asm 增加高半核映射后跳转到高地址。
 * 低地址链接的原因：boot.asm 建立恒等映射即可运行，改动最小。
 */
KERNEL_VIRT_BASE = 0x00000000;

/* 内核物理地址基址：从 1MB 处开始加载 */
KERNEL_PHYS_BASE = 0x00100000;

/* ------------------------------------------------------------
 * 段（Sections）布局定义
 * ------------------------------------------------------------
 * SECTIONS 块定义了各个段在内存中的位置和排列顺序
 * 所有地址都是相对于最终加载地址（由 AXIS Bootloader 决定）
 */
SECTIONS
{
    /* 虚拟地址从 KERNEL_VIRT_BASE + KERNEL_PHYS_BASE 开始 */
    . = KERNEL_VIRT_BASE + KERNEL_PHYS_BASE;

    /* 起始符号（虚拟地址 & 物理地址） */
    __kernel_virt_start = .;
    __kernel_phys_start = KERNEL_PHYS_BASE;

    /* ========================================================
     * .boot - 引导段（代码 + 数据，可执行、可读写）
     * ========================================================
     * 存放 boot.asm 的引导代码和临时页表，必须位于映像最前，
     * 因为 Bootloader 直接跳转到 _boot（映像起始处）执行。
     *
     * 该段同时包含代码（_boot、init_page_tables）和
     * 数据（GDT、PML4/PDPT/PD 页表），因此需要可写可执行。
     */
    .boot : AT(. - KERNEL_VIRT_BASE)
    {
        *(.boot)
    }

    /* ========================================================
     * .text - 代码段（只读、可执行）
     * ========================================================
     * 4KB 是 x86_64 的分页大小，对齐有利于内存管理和缓存效率
     * 
     * *(.text .text.*) 匹配所有 .text 开头的段：
     *   - .text 包含所有函数代码（Rust、汇编、内联汇编）
     *   - .text.* 匹配 LLVM 生成的带后缀的段
     *   - 后缀格式通常为 .text._ZN...（Rust 符号修饰）
     *   - 包括内核的所有执行代码
     * 
     * 注意：代码段在运行时是只读的，操作系统/内核必须保护它不被修改
     */
    .text : AT(. - KERNEL_VIRT_BASE)
    {
        *(.text .text.*)
    }

    /* ========================================================
     * .rodata - 只读数据段（只读、不可执行）
     * ========================================================
     * 存放常量数据：
     *   - 字符串字面量（"Hello, World!" 等）
     *   - 静态常量（const 变量）
     *   - 虚表（vtable，用于 trait 对象的动态分发）
     *   - 编译时确定的查找表（如 Unicode 映射表）
     *   - 内核的 GDT/IDT 描述符等只读数据结构
     * 
     * 对齐到 4KB 边界：
     *   - 与分页大小保持一致
     *   - 便于 MMU 设置只读权限（整个页只读）
     * 
     * 安全性考虑：
     *   - 该段在运行时不可修改，防止代码注入或数据篡改
     *   - 内核应尽量将常量数据放在只读区域
     */
    . = ALIGN(4096);
    __rodata_virt = .;
    .rodata : AT(__rodata_virt - KERNEL_VIRT_BASE)
    {
        *(.rodata .rodata.*)
    }

    /* ========================================================
     * .data - 已初始化数据段（可读写）
     * ========================================================
     * 存放已初始化的全局变量和静态变量：
     *   - 静态变量（static mut 或 static 有初始值）
     *   - 全局分配器（allocator）的元数据
     *   - 内核配置参数（如启动参数、硬件配置）
     *   - 设备驱动中的状态变量
     * 
     * 该段在二进制文件中占用空间：
     *   - 初始值直接嵌入在 ELF 文件中
     *   - 由引导程序或加载器复制到内存指定位置
     *   - 运行时可以读写修改
     * 
     * 对齐到 4KB 边界便于内存管理
     */
    . = ALIGN(4096);
    __data_virt = .;
    .data : AT(__data_virt - KERNEL_VIRT_BASE)
    {
        *(.data .data.*)
    }

    /* ========================================================
     * .bss - 未初始化数据段（可读写，初始值为零）
     * ========================================================
     * BSS（Block Started by Symbol）段：
     *   - 存放未初始化的全局/静态变量
     *   - 这些变量在程序启动时应该被清零
     *   - 二进制文件中不占用存储空间（只记录大小）
     *   - 节省磁盘空间和启动加载时间
     * 
     * 典型的 BSS 数据：
     *   - 栈空间（内核栈）
     *   - 堆空间（内存分配器的空闲区域）
     *   - 大型数据结构（如页表、进程控制块）
     *   - 未初始化的静态缓冲区
     * 
     * *(COMMON) 匹配通用符号：
     *   - 这些是 C 语言中未初始化的全局变量（Rust 通常不会生成）
     *   - 保留以确保兼容性和完整性
     * 
     * 关键操作：
     *   - 内核必须在启动时手动清零此区域
     *   - 可通过汇编指令（rep stosq）或 Rust 的 core::ptr::write_bytes 实现
     *   - 清零操作在启用分页之前或之后执行（取决于设计）
     *   - 未清零的 BSS 会导致未定义行为（如指针解引用错误）
     */
    . = ALIGN(4096);
    __bss_virt = .;
    .bss : AT(__bss_virt - KERNEL_VIRT_BASE)
    {
        __bss_start = .;          /* 虚拟地址 */
        *(.bss .bss.*)
        *(COMMON)
        __bss_end = .;            /* 虚拟地址 */
    }

    /* 内核结束地址（虚拟 & 物理） */
    __kernel_virt_end = .;
    __kernel_phys_end = . - KERNEL_VIRT_BASE;

    /* ========================================================
     * /DISCARD/ - 丢弃不需要的段
     * ========================================================
     * 这些段在最终二进制文件中被完全移除，不占用空间
     * 
     * .eh_frame: 异常处理帧信息
     *   - 用于 C++ 的 unwinding（栈展开）
     *   - Rust 在裸机环境中不使用异常处理（panic = abort）
     *   - 移除可减小二进制体积（通常数千字节）
     * 
     * .note .note.*: ELF 注释段
     *   - 包含 ABI 版本、编译器信息、版权声明等元数据
     *   - 对内核运行无关紧要，可以安全丢弃以减小体积
     *   - 注意：某些调试器可能需要这些信息，但生产环境中不需要
     */
    /DISCARD/ :
    {
        *(.eh_frame)
        *(.comment)
        *(.note*)
    }
}
