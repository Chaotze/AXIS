/* ============================================================
 * BIOS Stage2 链接脚本
 * ============================================================
 * 定义 Stage2 的内存布局和链接规则
 *
 * Stage2 加载地址：0x7e00（紧随 MBR 之后）
 * 目标：将汇编代码和 Rust 代码正确链接在一起
 */

/* 输出格式：纯二进制（不是 ELF） */
OUTPUT_FORMAT(binary)

/* 入口点：stage2_entry（Stage2 汇编代码的入口） */
ENTRY(stage2_entry)

/* 内存布局 */
SECTIONS
{
    /* 起始地址：Stage1 将 Stage2 加载到 0x7e00 */
    . = 0x7e00;

    /* 代码段：包含汇编和 Rust 代码 */
    .text : {
        /* 首先放置汇编入口代码 */
        *(.text.stage2_entry)

        /* 然后放置其他汇编代码 */
        *(.text)

        /* Rust 代码 */
        *(.text.*)
    }

    /* 只读数据段：字符串常量等 */
    .rodata : ALIGN(4) {
        *(.rodata)
        *(.rodata.*)
    }

    /* 可读写数据段：全局变量、静态变量等 */
    .data : ALIGN(4) {
        *(.data)
        *(.data.*)
    }

    /* BSS 段：未初始化的全局变量 */
    /* 为什么需要对齐？
     *   - BSS 段在运行时需要被清零
     *   - 对齐可以使用高效的批量清零指令（如 rep stosd）
     */
    .bss : ALIGN(4) {
        __bss_start = .;
        *(.bss)
        *(.bss.*)
        *(COMMON)
        __bss_end = .;
    }

    /* 丢弃调试信息和其他不需要的段 */
    /* 为什么丢弃？
     *   - 引导加载程序需要精简，不需要调试符号
     *   - 减小二进制体积，加快加载速度
     */
    /DISCARD/ : {
        *(.eh_frame)        /* 异常处理帧（栈展开信息） */
        *(.comment)         /* 编译器注释 */
        *(.note*)           /* 注释段 */
    }
}
