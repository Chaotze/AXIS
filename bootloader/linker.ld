/* ============================================================
 * 链接器脚本 - x86_64 裸机引导程序内存布局
 * ============================================================
 * 该文件定义了目标可执行文件的内存布局和段（section）放置规则
 * 由 build.rs 在编译时通过 -T 参数传递给 rustc 链接器（ld）
 * 适用平台：x86_64-axis（即 x86_64-unknown-none，裸机）
 *
 * 注意：链接器脚本的语法是 GNU ld 脚本语言，而非 Rust 代码
 */

/* ------------------------------------------------------------
 * 入口点（Entry Point）
 * ------------------------------------------------------------
 * ENTRY 指定程序开始执行的符号（函数名）
 * _start 是引导程序的入口，由汇编或 Rust 的 #[no_mangle] 函数定义
 * 注意：_start 必须使用全局可见性（pub extern "C" fn _start()）
 *       且不能依赖任何标准库初始化（因为裸机环境没有）
 */
ENTRY(_start)

/* ------------------------------------------------------------
 * 段（Sections）布局定义
 * ------------------------------------------------------------
 * SECTIONS 块定义了各个段在内存中的位置和排列顺序
 * 所有地址都是相对于最终加载地址（通常由目标平台决定）
 */
SECTIONS
{
    /* 设置当前地址计数器（Location Counter）为 1MB
     * . = 1M; 表示将所有段放置在物理内存的 1MB 起始位置
     * 原因：x86 架构中，1MB 以下是传统 BIOS 区域（如 VGA 显存、BIOS 数据等）
     *       1MB 以上是常规内存区域，适合放置引导程序
     * 对于 Multiboot 兼容的引导程序，内核通常加载到 1MB 以上
     */
    . = 1M;

    /* ========================================================
     * .multiboot_header - Multiboot 头部段
     * ========================================================
     * 这是最先被放置的段，确保 Multiboot 头部在二进制文件的最开头
     * Multiboot 规范要求头部必须位于文件的前 8KB 或 4 字节对齐范围内
     * 
     * KEEP() 强制保留该段，即使 Rust 编译器认为它未被引用
     * *(.multiboot_header) 匹配所有输入目标文件中的 .multiboot_header 段
     * 
     * 该段由汇编或 Rust 代码定义，包含引导加载程序（如 GRUB）需要的魔数、
     * 标志位和校验和等信息，用于识别该内核是 Multiboot 兼容的
     */
    .multiboot_header :
    {
        KEEP(*(.multiboot_header))
    }

    /* ========================================================
     * .text - 代码段（只读、可执行）
     * ========================================================
     * ALIGN(4K) 将段起始地址对齐到 4KB 边界
     * 4KB 是 x86_64 的分页大小，对齐有利于内存管理和缓存效率
     * 
     * *(.text .text.*) 匹配所有 .text 开头的段
     * 包含所有函数代码（Rust 的 .text 段、汇编代码等）
     * .text.* 用于匹配 LLVM 生成的带后缀的段（如 .text._ZN...）
     */
    .text : ALIGN(4K)
    {
        *(.text .text.*)
    }

    /* ========================================================
     * .rodata - 只读数据段（只读、不可执行）
     * ========================================================
     * 存放常量数据：字符串字面量、静态常量、虚表（vtable）等
     * 该段在运行时不可修改，通常位于只读内存区域
     * 对齐到 4KB 边界，与分页大小保持一致
     */
    .rodata : ALIGN(4K)
    {
        *(.rodata .rodata.*)
    }

    /* ========================================================
     * .data - 已初始化数据段（可读写）
     * ========================================================
     * 存放已初始化的全局变量和静态变量
     * 这些变量在程序启动时已有初始值，由操作系统或引导程序加载器负责初始化
     * 在裸机环境中，这些初始值直接嵌入在二进制文件中
     */
    .data : ALIGN(4K)
    {
        *(.data .data.*)
    }

    /* ========================================================
     * .bss - 未初始化数据段（可读写，初始值为零）
     * ========================================================
     * BSS（Block Started by Symbol）段存放未初始化的全局/静态变量
     * 这些变量在程序启动时应该被清零，但二进制文件中不占用存储空间
     * 引导程序必须在运行时手动清零此区域（通过汇编或 Rust 代码）
     * 
     * *(COMMON) 匹配通用符号（common symbols），这些是未初始化的全局变量
     * 由于 Rust 通常不会生成 COMMON 符号，但保留以兼容其他语言
     */
    .bss : ALIGN(4K)
    {
        *(.bss .bss.*)
        *(COMMON)
    }

    /* ========================================================
     * /DISCARD/ - 丢弃不需要的段
     * ========================================================
     * 这些段在最终二进制文件中被完全移除，不占用空间
     * 
     * .eh_frame: 异常处理帧信息，用于 C++ 的 unwinding
     *             Rust 在裸机环境中不使用异常处理（panic = abort）
     *             移除可减小二进制体积，避免引入额外依赖
     * 
     * .note .note.*: 注释段，包含 ELF 注释（如 ABI 版本、编译器信息等）
     *                对引导程序运行无关紧要，可以安全丢弃
     *                注意：这可能会影响某些调试工具，但对启动过程无影响
     */
    /DISCARD/ :
    {
        *(.eh_frame)
        *(.note .note.*)
    }
}

/* ============================================================
 * 补充说明：
 * 1. 内存布局原则：从低地址到高地址依次放置各段
 *    1MB 起始 -> Multiboot 头 -> 代码 -> 只读数据 -> 数据 -> BSS
 * 
 * 2. 为什么从 1MB 开始？因为 1MB 以下是 BIOS 保留区域，包括：
 *    - 0x00000000-0x000003FF: 中断向量表（IVT）
 *    - 0x00000400-0x000004FF: BIOS 数据区（BDA）
 *    - 0x0007C00-0x0007DFF: 通常的 MBR 引导扇区加载位置
 *    - 0x0009FC00-0x0009FFFF: EBDA（扩展 BIOS 数据区）
 *    - 0x000A0000-0x000FFFFF: VGA 显存、BIOS ROM 等
 *    因此 1MB 是最安全、最低的可用常规内存起始地址
 * 
 * 3. ALIGN(4K) 的意义：
 *    - 4KB 是 x86_64 页表的最小粒度，确保段边界与页对齐
 *    - 便于内存管理单元（MMU）进行分页映射
 *    - 提高 CPU 缓存利用率（缓存行通常为 64 字节，4KB 是 64 的倍数）
 * 
 * 4. 为什么丢弃 .eh_frame？
 *    - 裸机没有运行时进行栈展开（unwind）的机制
 *    - 使用 panic = "abort" 时，异常永远不会被捕获
 *    - 移除该段可减少约数千字节的体积（对 MBR 限制的 512 字节至关重要）
 * 
 * 5. 段顺序的重要性：
 *    - 某些引导加载程序（如 GRUB）期望 Multiboot 头部在文件开头附近
 *    - 入口点 _start 必须在 .text 段中，且通常位于段的前部
 *    - 某些硬件可能需要特定段对齐（如 DMA 缓冲区需要页对齐）
 * ============================================================
 */
